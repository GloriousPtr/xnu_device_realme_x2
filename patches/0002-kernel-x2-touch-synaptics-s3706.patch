+	unsigned syna_data, syna_f01;
 	unsigned fts5_reads, fts5_events, fts5_nacks;
 	int fts5_err;
 	uint32_t irq_status, irq_last, active;
@@ -523,6 +544,108 @@ touch_focaltech(void)
