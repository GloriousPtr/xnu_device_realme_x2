+/* Realme X2 bring-up and poll loop (boot-arg sweetx2=1). Never touches 0x5d/0x38/GPIO 90. */
+static void
+touch_x2_run(void)
+{
+	printf("SWEET TOUCH: Realme X2 / Synaptics S3706 path (sweetx2=1)\n");
+	/* Reset low while the rails come up; IRQ is an input with pull-up (DTS ts_int_active). */
+	touch_gpio(9, 0, 3, 3, false, false);
+	touch_gpio(8, 0, 0, 3, true, false);
+	int err = sweet_rpmh_vreg_enable("ldoa12", 1800); /* vcc_1v8 = pm6150_l12 */
+	if (err) {
+		printf("SWEET TOUCH: ldoa12 RPMh enable failed %d; stopping\n", err);
+		return;
+	}
+	err = sweet_rpmh_vreg_enable("ldoc7", 3100); /* vdd_2v8 = pm6150l_l7 */
+	if (err) {
+		printf("SWEET TOUCH: ldoc7 RPMh enable failed %d; stopping\n", err);
+		return;
+	}
+	touch_wait(10);
+	touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, same pins as sweet */
+	touch_gpio(7, 1, 0, 0, false, false);
+	/* Realme synaptics_reset(): reset low 10 ms, high, then 80 ms to normal operation. */
+	touch_gpio(8, 0, 0, 3, true, false);
+	touch_wait(10);
+	touch_gpio(8, 0, 0, 3, true, true);
+	touch_wait(300); /* generous: vendor RESET_TO_NORMAL_TIME is 80 ms */
+	st.probing = true;
+	bool ok = touch_syna_probe();
+	st.probing = false;
+	if (!ok || st.dead) {
+		printf("SWEET TOUCH: S3706 not usable (ok=%d dead=%d); stopping\n", ok, st.dead);
+		return;
+	}
+	st.kind = TOUCH_SYNA;
+	printf("SWEET TOUCH: selected Synaptics S3706, 1080x2340, poll=10ms irq-hint=%d\n", st.irq_hint);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) ||
+			(++ticks % 10u) == 0) {
+			int e = touch_syna();
+		if (e) {
+			if ((errors++ % 100u) == 0) {
+				printf("SWEET TOUCH: report err=%d irq=%#x\n", e, st.irq_status);
+			}
+			if (errors == 10) {
+				touch_report(0, st.x, st.y);
+			}
+		} else {
+			errors = 0;
+		}
+			}
+			touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+}
