+/*
+ * Realme X2 (RMX1992): Synaptics S3706 (RMI4) at I2C 0x20 on the same SE7 bus
+ * as sweet's touch IC. IRQ = TLMM 9, reset = TLMM 8 (X2 kernel DTS,
+ * arch/arm64/boot/dts/19771/sdmmagpie-idp.dtsi). Rails: vcc_1v8 = pm6150_l12
+ * (RPMh ldoa12, 1.8 V), vdd_2v8 = pm6150l_l7 (RPMh ldoc7; the Oppo driver
+ * default is 3.1 V). Register map: Realme's synaptics_drivers_s3706.c.
+ */
+#define SYNA_ADDR         0x20u
+#define SYNA_PAGE_SEL     0xffu
+#define SYNA_PDT_FIRST    0xc0u    /* page 0: F12 @0xdd, F01 @0xe3, F34 @0xe9 */
+#define SYNA_PDT_LEN      48u
+#define SYNA_F12_OFF      (0xddu - SYNA_PDT_FIRST)
+#define SYNA_F01_OFF      (0xe3u - SYNA_PDT_FIRST)
+#define SYNA_F34_OFF      (0xe9u - SYNA_PDT_FIRST)
+#define SYNA_REC_LEN      8u       /* RMI4 F12 object record */
+#define SYNA_MAX_X        1079u
+#define SYNA_MAX_Y        2339u
+#define SYNA_DUMP_DEFAULT 30
+
 /*
  * Pixel 4a (sunfish, boot-arg sweetfts=1): STMicro FTM5 at 0x49 on the same
  * SE7 / qup11 pins (TLMM 6/7) and reset/IRQ pins (TLMM 8/9) as the GT9896.
@@ -108,7 +128,8 @@ void sweet_touch_init(void);
