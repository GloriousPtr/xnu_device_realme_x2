+static void
+touch_hexdump(const char *tag, unsigned base, const uint8_t *buf, unsigned len)
+{
+	for (unsigned off = 0; off < len; off += 16) {
+		char line[49];
+		unsigned n = len - off < 16 ? len - off : 16;
+		for (unsigned j = 0; j < n; ++j) {
+			(void)snprintf(line + j * 3u, 4, "%02x ", buf[off + j]);
+		}
+		printf("SWEET TOUCH: %s %#x: %s\n", tag, base + off, line);
+	}
+}
+
+/*
+ * Synaptics S3706 (RMI4). Only IC writes: page select 0 and F01 control 0
+ * (normal operation + configured, as Realme's synaptics_configuration_init).
+ */
+static bool
+touch_syna_probe(void)
+{
+	uint8_t pg[2] = {SYNA_PAGE_SEL, 0};
+	uint8_t pdt[SYNA_PDT_LEN];
+	int err = touch_msg(SYNA_ADDR, pg, sizeof(pg), NULL, 0, false);
+	if (err) {
+		printf("SWEET TOUCH: S3706 page select err=%d (no ACK at 0x20: power/reset/bus?)\n", err);
+		return false;
+	}
+	err = touch_read(SYNA_ADDR, SYNA_PDT_FIRST, false, pdt, sizeof(pdt));
+	if (err) {
+		printf("SWEET TOUCH: S3706 PDT read err=%d\n", err);
+		return false;
+	}
+	touch_hexdump("S3706 PDT", SYNA_PDT_FIRST, pdt, sizeof(pdt));
+	/* PDT entry: query, command, control, data base, irq info, function number. */
+	const uint8_t *f12 = pdt + SYNA_F12_OFF;
+	const uint8_t *f01 = pdt + SYNA_F01_OFF;
+	const uint8_t *f34 = pdt + SYNA_F34_OFF;
+	if (f12[5] != 0x12 || f01[5] != 0x01 || f34[5] != 0x34) {
+		printf("SWEET TOUCH: S3706 PDT mismatch (F12 id %#x, F01 id %#x, F34 id %#x); "
+		"not an S3706 in normal mode (bootloader/update mode?)\n",
+			   f12[5], f01[5], f34[5]);
+		return false;
+	}
+	st.syna_data = f12[3];
+	st.syna_f01 = f01[3];
+	printf("SWEET TOUCH: S3706 F12 query=%#x cmd=%#x ctrl=%#x data=%#x; F01 ctrl=%#x data=%#x\n",
+		   f12[0], f12[1], f12[2], f12[3], f01[2], f01[3]);
+	uint8_t c0 = 0;
+	err = touch_read(SYNA_ADDR, f01[2], false, &c0, 1);
+	if (!err) {
+		uint8_t w[2] = {f01[2], (uint8_t)((c0 & 0xf8u) | 0x80u)};
+		err = touch_msg(SYNA_ADDR, w, sizeof(w), NULL, 0, false);
+		printf("SWEET TOUCH: S3706 F01 ctrl0 %#x -> %#x err=%d\n", c0, w[1], err);
+	}
+	return !err;
+}
+
+static int
+touch_syna(void)
+{
+	static uint8_t prev[TOUCH_MAX * SYNA_REC_LEN];
+	static bool first = true;
+	uint8_t f01[2], buf[TOUCH_MAX * SYNA_REC_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	/* F01 device status + interrupt status; reading the latter releases ATTN. */
+	int err = touch_read(SYNA_ADDR, (uint8_t)st.syna_f01, false, f01, sizeof(f01));
+	if (err) {
+		return err;
+	}
+	err = touch_read(SYNA_ADDR, (uint8_t)st.syna_data, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + i * SYNA_REC_LEN;
+		/* RMI4 F12 object types: 1 finger, 3 palm, 4 unclassified, 6 glove. */
+		if (p[0] != 1u && p[0] != 3u && p[0] != 4u && p[0] != 6u) {
+			continue;
+		}
+		unsigned px = ((unsigned)(p[2] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[4] & 15u) << 8) | p[3];
+		if (px > SYNA_MAX_X || py > SYNA_MAX_Y) {
+			continue;
+		}
+		mask |= 1u << i;
+		x[i] = (int)px;
+		y[i] = (int)py;
+	}
+	/* The F12 record layout is taken from Realme's driver but unverified on
+	 * hardware: log raw data whenever it changes (sweettouchdump=N lines). */
+	if (st.dump > 0 && (first || memcmp(prev, buf, sizeof(buf)) != 0)) {
+		printf("SWEET TOUCH: S3706 f01 status=%#x irq=%#x mask=%#x\n", f01[0], f01[1], mask);
+		touch_hexdump("S3706 F12", st.syna_data, buf, 3u * SYNA_REC_LEN);
+		memcpy(prev, buf, sizeof(buf));
+		first = false;
+		--st.dump;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
