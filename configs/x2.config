# Board facts of the realme X2 (x2, RMX1992) that are true of this phone and of no other SM7150.
# Read from ios-sweet-x2's sources (touch, keys, display); the kernel still carries its own copies.
CONFIG_DEVICE="x2"
CONFIG_PANEL_WIDTH=1080
CONFIG_PANEL_HEIGHT=2340
# Synaptics S3706 (RMI4) at I2C address 0x20 on GENI SE7 (qup11; TLMM 6/7 are SDA/SCL), reset TLMM 8, IRQ TLMM 9
CONFIG_TOUCH_CHIP="synaptics-s3706"
CONFIG_TOUCH_I2C_ADDR=0x20
CONFIG_TOUCH_SE_PA=0x00a84000
CONFIG_TOUCH_RESET_GPIO=8
CONFIG_TOUCH_IRQ_GPIO=9
# vcc_1v8 = pm6150_l12 (RPMh ldoa12, 1.8 V), vdd_2v8 = pm6150l_l7 (RPMh ldoc7, 3.1 V)
CONFIG_TOUCH_RAIL="ldoa12,ldoc7"
CONFIG_TOUCH_MAX_X=1079
CONFIG_TOUCH_MAX_Y=2339
# power and volume keys on the PMIC over SPMI, polled
CONFIG_BUTTONS="spmi"
# the framebuffer the stock bootloader (ABL) leaves, and the MDP that scans it out (DSI command mode)
CONFIG_SPLASH_PA=0x9c000000
CONFIG_MDP_PA=0x0ae00000
